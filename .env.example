# LDA environment template
# Copy this to `.env.local` for local development.
# Do not commit real secrets.

APP_ENV=staging
APP_NAME=L Driving Academy
APP_SUPPORT_EMAIL=info@ldrivingacademy.co.uk
APP_WEBSITE_URL=https://ldrivingacademy.co.uk

# Supabase Auth, Postgres, Storage
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback if you use an anon key instead of a publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Stripe Connect marketplace payments
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=
STRIPE_DEFAULT_CURRENCY=gbp
STRIPE_ENABLE_PAYPAL=false
STRIPE_LEARNER_PLUS_MONTHLY_PRICE_ID=
STRIPE_LEARNER_PLUS_YEARLY_PRICE_ID=
STRIPE_LEARNER_PRO_MONTHLY_PRICE_ID=
STRIPE_LEARNER_PRO_YEARLY_PRICE_ID=
LDA_PLATFORM_COMMISSION_PERCENT=10
LDA_INSTANT_LESSON_PRICE_PENCE=6500

# Google Maps live tracking / Places / distance features
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_SERVER_API_KEY=

# DVLA Access to Driver Data API
# Requires DVLA approval and must only be used with permission and a lawful entitlement-check purpose.
DVLA_ACCESS_TO_DRIVER_DATA_URL=https://driver-vehicle-licensing.api.gov.uk/full-driver-enquiry/v1/driving-licences/retrieve
DVLA_ACCESS_TO_DRIVER_DATA_API_KEY=
DVLA_ACCESS_TO_DRIVER_DATA_JWT=

# UK postcode lookup
POSTCODES_IO_BASE_URL=https://api.postcodes.io

# Transactional email
EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=info@ldrivingacademy.co.uk
RESEND_REPLY_TO_EMAIL=info@ldrivingacademy.co.uk
LDA_SUPPORT_ESCALATION_EMAIL=info@ldrivingacademy.co.uk
LDA_FEEDBACK_EMAIL=info@ldrivingacademy.co.uk

# Optional SMS confirmations for lesson booking references
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# Learner support AI assistant
OPENAI_API_KEY=
OPENAI_SUPPORT_MODEL=gpt-5.2

# Optional monitoring
SENTRY_DSN=

# Compliance toggles
MIN_LEARNER_BOOKING_AGE=17
REQUIRE_PROVISIONAL_LICENSE_CONFIRMATION=true
REQUIRE_INSTRUCTOR_ADMIN_APPROVAL=true
REQUIRE_INSTRUCTOR_ADI_OR_PDI=true
REQUIRE_FULL_PRICE_UPFRONT=true
ALLOW_HIDDEN_BOOKING_FEES=false
DEFAULT_CANCELLATION_WINDOW_HOURS=24
