# LDA environment template
# Copy this to `.env.local` for local development.
# Do not commit real secrets.

APP_ENV=staging
APP_NAME=L Driving Academy
APP_SUPPORT_EMAIL=info@ldrivingacademy.co.uk
APP_WEBSITE_URL=https://ldrivingacademy.co.uk

# Supabase Auth, Postgres, Storage
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback if you use an anon key instead of a publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Stripe Connect marketplace payments
# Set to test/sandbox while developing. Set to live only when live keys and prices exist.
# Mode-specific values are read first, then neutral fallback values are allowed.
# Test mode reads TEST/NEXT_PUBLIC_TEST/STRIPE_TEST values plus neutral values. It never reads LIVE values.
# Live mode reads LIVE/NEXT_PUBLIC_LIVE/STRIPE_LIVE values plus neutral values. It never reads TEST values.
# Server-side checkout and API code treats STRIPE_MODE as the main switch.
# NEXT_PUBLIC_LDA_ENV_MODE mirrors the same mode for browser/build-time public config.
# After changing Stripe env vars in Vercel, redeploy so checkout uses the new values.
# If STRIPE_MODE is blank, the app uses neutral names only for backwards compatibility.
STRIPE_MODE=test
LDA_ENV_MODE=test
NEXT_PUBLIC_LDA_ENV_MODE=test

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# Legacy fallback names. Prefer STRIPE_TEST_* and STRIPE_LIVE_* in Vercel.
STRIPE_SECRET_KEY=
STRIPE_DEFAULT_CURRENCY=gbp
STRIPE_CHECKOUT_PAYMENT_METHOD_TYPES=
STRIPE_LEARNER_PLUS_MONTHLY_PRICE_ID=
STRIPE_LEARNER_PLUS_YEARLY_PRICE_ID=
STRIPE_LEARNER_PRO_MONTHLY_PRICE_ID=
STRIPE_LEARNER_PRO_YEARLY_PRICE_ID=
STRIPE_INSTRUCTOR_PLUS_MONTHLY_PRICE_ID=
STRIPE_INSTRUCTOR_PLUS_YEARLY_PRICE_ID=
STRIPE_INSTRUCTOR_PRO_MONTHLY_PRICE_ID=
STRIPE_INSTRUCTOR_PRO_YEARLY_PRICE_ID=

# Optional test/sandbox values. Use these when STRIPE_MODE=test.
NEXT_PUBLIC_TEST_SUPABASE_URL=
NEXT_PUBLIC_TEST_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_TEST_SUPABASE_ANON_KEY=
TEST_SUPABASE_SERVICE_ROLE_KEY=
STRIPE_TEST_SECRET_KEY=
NEXT_PUBLIC_TEST_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_TEST_PUBLISHABLE_KEY=
STRIPE_TEST_PUBLISHABLE_KEY=
STRIPE_TEST_DEFAULT_CURRENCY=gbp
STRIPE_TEST_CHECKOUT_PAYMENT_METHOD_TYPES=
STRIPE_TEST_LEARNER_PLUS_MONTHLY_PRICE_ID=
STRIPE_TEST_LEARNER_PLUS_YEARLY_PRICE_ID=
STRIPE_TEST_LEARNER_PRO_MONTHLY_PRICE_ID=
STRIPE_TEST_INSTRUCTOR_PLUS_MONTHLY_PRICE_ID=
STRIPE_TEST_INSTRUCTOR_PLUS_YEARLY_PRICE_ID=
STRIPE_TEST_INSTRUCTOR_PRO_MONTHLY_PRICE_ID=
STRIPE_TEST_INSTRUCTOR_PRO_YEARLY_PRICE_ID=

# Optional live values. Use these when STRIPE_MODE=live.
NEXT_PUBLIC_LIVE_SUPABASE_URL=
NEXT_PUBLIC_LIVE_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_LIVE_SUPABASE_ANON_KEY=
LIVE_SUPABASE_SERVICE_ROLE_KEY=
STRIPE_LIVE_SECRET_KEY=
NEXT_PUBLIC_LIVE_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_LIVE_PUBLISHABLE_KEY=
STRIPE_LIVE_PUBLISHABLE_KEY=
STRIPE_LIVE_DEFAULT_CURRENCY=gbp
STRIPE_LIVE_CHECKOUT_PAYMENT_METHOD_TYPES=
STRIPE_LIVE_LEARNER_PLUS_MONTHLY_PRICE_ID=
STRIPE_LIVE_LEARNER_PLUS_YEARLY_PRICE_ID=
STRIPE_LIVE_LEARNER_PRO_MONTHLY_PRICE_ID=
STRIPE_LIVE_INSTRUCTOR_PLUS_MONTHLY_PRICE_ID=
STRIPE_LIVE_INSTRUCTOR_PLUS_YEARLY_PRICE_ID=
STRIPE_LIVE_INSTRUCTOR_PRO_MONTHLY_PRICE_ID=
STRIPE_LIVE_INSTRUCTOR_PRO_YEARLY_PRICE_ID=
LDA_PLATFORM_COMMISSION_PERCENT=10
LDA_INSTANT_LESSON_PRICE_PENCE=6500

# Google Maps live tracking / Places / distance features
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_SERVER_API_KEY=

# DVLA Access to Driver Data API
# Requires DVLA approval and must only be used with permission and a lawful entitlement-check purpose.
DVLA_ACCESS_TO_DRIVER_DATA_URL=https://driver-vehicle-licensing.api.gov.uk/full-driver-enquiry/v1/driving-licences/retrieve
DVLA_ACCESS_TO_DRIVER_DATA_API_KEY=
DVLA_ACCESS_TO_DRIVER_DATA_JWT=

# UK postcode lookup
POSTCODES_IO_BASE_URL=https://api.postcodes.io

# Transactional email
EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=info@ldrivingacademy.co.uk
RESEND_REPLY_TO_EMAIL=info@ldrivingacademy.co.uk
LDA_SUPPORT_ESCALATION_EMAIL=info@ldrivingacademy.co.uk
LDA_FEEDBACK_EMAIL=info@ldrivingacademy.co.uk

# Optional SMS confirmations for lesson booking references
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# Learner support AI assistant
OPENAI_API_KEY=
OPENAI_SUPPORT_MODEL=gpt-5.2

# Optional monitoring
SENTRY_DSN=

# Compliance toggles
MIN_LEARNER_BOOKING_AGE=17
REQUIRE_PROVISIONAL_LICENSE_CONFIRMATION=true
REQUIRE_INSTRUCTOR_ADMIN_APPROVAL=true
REQUIRE_INSTRUCTOR_ADI_OR_PDI=true
REQUIRE_FULL_PRICE_UPFRONT=true
ALLOW_HIDDEN_BOOKING_FEES=false
DEFAULT_CANCELLATION_WINDOW_HOURS=24
