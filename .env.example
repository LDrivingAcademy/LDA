# LDA environment template
# Copy this to `.env.local` for local development.
# Do not commit real secrets.

APP_ENV=staging
APP_NAME=L Driving Academy
APP_SUPPORT_EMAIL=info@ldrivingacademy.co.uk
APP_WEBSITE_URL=https://ldrivingacademy.co.uk

# Supabase / database
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Stripe Connect marketplace payments
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=
STRIPE_DEFAULT_CURRENCY=gbp
LDA_PLATFORM_COMMISSION_PERCENT=10

# Google Maps live tracking / Places / distance features
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_SERVER_API_KEY=

# UK postcode lookup
POSTCODES_IO_BASE_URL=https://api.postcodes.io

# Email
RESEND_API_KEY=
RESEND_FROM_EMAIL=info@ldrivingacademy.co.uk

# Compliance toggles
MIN_LEARNER_BOOKING_AGE=17
REQUIRE_PROVISIONAL_LICENSE_CONFIRMATION=true
REQUIRE_INSTRUCTOR_ADMIN_APPROVAL=true
REQUIRE_INSTRUCTOR_ADI_OR_PDI=true
REQUIRE_FULL_PRICE_UPFRONT=true
ALLOW_HIDDEN_BOOKING_FEES=false
DEFAULT_CANCELLATION_WINDOW_HOURS=24
